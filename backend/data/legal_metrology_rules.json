  "ecommerce_rules": [
    {
      "code": "ECOMMERCE_MANDATORY_DISPLAY",
      "rule": "Rule 6(10)",
      "field": "ecommerce_listing",
      "is_ecommerce_rule": true,
      "severity": "HIGH",
      "description": "Digital listings must display mandatory declarations (Manufacturer, Net Qty, MRP, USP, Consumer Care) on the product display page prior to purchase."
    }
  ],
  "multipack_rules": [
    {
      "code": "MULTIPACK_INDIVIDUAL_DECLARATION",
      "rule": "Rule 6(5) & Rule 13(6)",
      "field": "multipack_quantity",
      "is_multipack_rule": true,
      "severity": "HIGH",
      "description": "Multi-piece packages must declare number of individual units and net quantity per unit as supplementary declaration (e.g., 10 N x 10 g) alongside total net quantity."
    }
  ],
  "exemptions": [
    {
      "code": "EXEMPT_SMALL_PACK",
      "rule": "Rule 26(a)",
      "category": "Small Packages",
      "max_quantity": 10,
      "unit": "g_or_ml",
      "exempt_fields": ["mrp", "mfg_date", "unit_sale_price"],
      "notes": "Package containing 10g or 10ml or less. Tobacco products excluded from exemption w.e.f 2016."
    },
    {
      "code": "EXEMPT_FAST_FOOD",
      "rule": "Rule 26(b)",
      "category": "Fast Food",
      "exempt_fields": ["mrp", "mfg_date", "net_quantity", "unit_sale_price"],
      "notes": "Fast food items packed by hotel/restaurant."
    },
    {
      "code": "EXEMPT_DPCO_DRUGS",
      "rule": "Rule 26(c)",
      "category": "DPCO Formulations",
      "exempt_fields": ["mrp"],
      "notes": "Covered under Drugs (Price Control) Order."
    },
    {
      "code": "EXEMPT_BULK_AGRI",
      "rule": "Rule 26(d)",
      "category": "Agricultural Produce",
      "min_quantity": 50,
      "unit": "kg",
      "exempt_fields": ["mrp", "mfg_date", "unit_sale_price"],
      "notes": "Agricultural produce in packages above 50kg."
    },
    {
      "code": "EXEMPT_HANDLOOM_THREAD",
      "rule": "Rule 26(e)",
      "category": "Handloom Yarn",
      "exempt_fields": ["mrp", "unit_sale_price"],
      "notes": "Thread sold in coils to handloom weavers."
    }
  ],
