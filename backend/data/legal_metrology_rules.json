  "requirements": [
    {
      "code": "MANUFACTURER_ADDRESS",
      "rule": "Rule 6(1)(a) & 10",
      "field": "manufacturer_details",
      "severity": "HIGH",
      "machine_checkable": true,
      "regex_pattern": "(?i)(mfd\\.?\\s*by|marketed\\s*by|pkd\\.?\\s*by|imported\\s*by|manufactured\\s*by)[:\\s]+([A-Za-z0-9\\s,.-]+(?:\\b\\d{6}\\b)?)",
      "description": "Manufacturer, Packer, or Importer complete name and registered address with PIN code."
    },
    {
      "code": "GENERIC_NAME",
      "rule": "Rule 6(1)(b)",
      "field": "commodity_name",
      "severity": "HIGH",
      "machine_checkable": true,
      "regex_pattern": "(?i)(commodity|product|item|name)[:\\s]+([A-Za-z0-9\\s-]+)",
      "description": "Common or generic name of the commodity contained in the package."
    },
    {
      "code": "NET_QUANTITY",
      "rule": "Rule 6(1)(c) & 13",
      "field": "net_quantity",
      "severity": "HIGH",
      "machine_checkable": true,
      "allowed_units": ["g", "kg", "mL", "ml", "L", "l", "m", "cm", "mm", "N", "U"],
      "regex_pattern": "(?i)(?:net\\s*(?:qty|quantity|wt|weight|vol|volume)?[:\\s]*)(\\d+(?:\\.\\d+)?)\\s*(g|kg|ml|mL|l|L|m|cm|mm|N|U)\\b",
      "description": "Net quantity in standard metric SI symbols (g, kg, mL, L, m, cm, N, U)."
    },
    {
      "code": "MFG_DATE",
      "rule": "Rule 6(1)(d)",
      "field": "mfg_date",
      "severity": "HIGH",
      "machine_checkable": true,
      "regex_pattern": "(?i)(?:mfg|pkd|packed|date|mfd)[:\\s]*((?:0[1-9]|1[0-2])\\/(?:20)?\\d{2}|(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\\s*(?:20)?\\d{2})",
      "description": "Month and Year of manufacture in MM/YYYY or Month Year format."
    },
    {
      "code": "MRP_TAX_STATEMENT",
      "rule": "Rule 6(1)(e)",
      "field": "mrp",
      "severity": "HIGH",
      "machine_checkable": true,
      "regex_pattern": "(?i)(?:m\\.?r\\.?p\\.?|max(?:imum)?\\s*retail\\s*price)[:\\s]*(?:rs\\.?|₹)?\\s*(\\d+(?:\\.\\d{2})?)[^\\n]*?(incl(?:usive)?\\.?\\s*of\\s*all\\s*taxes)",
      "description": "Maximum Retail Price in Indian Rupees stating 'inclusive of all taxes' or 'incl. of all taxes'."
    },
    {
      "code": "COUNTRY_OF_ORIGIN",
      "rule": "Rule 6(1)(f)",
      "field": "country_of_origin",
      "severity": "HIGH",
      "machine_checkable": true,
      "regex_pattern": "(?i)(country\\s*of\\s*origin|made\\s*in|origin)[:\\s]+([A-Za-z\\s]+)",
      "description": "Declaration of the country of origin on imported and domestic packaged commodities."
    },
    {
      "code": "CONSUMER_CARE",
      "rule": "Rule 6(2)",
      "field": "consumer_care",
      "severity": "HIGH",
      "machine_checkable": true,
      "description": "Full complaint contact details containing Name/Designation, Phone, Email, and Postal Address."
    },
    {
      "code": "UNIT_SALE_PRICE",
      "rule": "Rule 6(11)",
      "field": "unit_sale_price",
      "severity": "HIGH",
      "machine_checkable": true,
      "effective_from": "2022-10-01",
      "regex_pattern": "(?i)(?:u(?:nit)?\\s*s(?:ale)?\\s*p(?:rice)?|usp)[:\\s]*(?:rs\\.?|₹)?\\s*(\\d+(?:\\.\\d{1,2})?)\\s*(?:per|\\/)\\s*(g|kg|ml|l|m|cm|n|u|piece|item)",
      "description": "Unit Sale Price (USP) declared rounded off to two decimal places (e.g., Rs. X.XX per g/kg/mL/L/m/cm/number)."
    },
    {
      "code": "COSMETIC_ORIGIN_DOT",
      "rule": "Rule 6(8)",
      "field": "cosmetic_origin_dot",
      "severity": "MEDIUM",
      "machine_checkable": true,
      "effective_from": "2014-07-01",
      "description": "Red/Brown dot for non-vegetarian or Green dot for vegetarian origin on cosmetics/toiletries."
    }
  ],
